{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".validate": "$code.matches(/^[A-Z]{4}$/)",
        "peers": {
          ".read": "auth != null",
          "$peer": {
            ".write": "auth != null && auth.uid === $peer",
            "$field": {
              ".validate": "$field.matches(/^[A-Za-z0-9_]{1,12}$/) && newData.isString() && newData.val().length <= 64000"
            }
          }
        }
      }
    }
  }
}
